APP_ENV=development
APP_NAME=CORE Wine Club
API_V1_PREFIX=/api/v1

POSTGRES_DB=core_wine_club
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Local demo default, used by GlobalGreenInvest no-Docker scripts:
# DATABASE_URL=sqlite:///./local_dev.db

# Docker/Postgres local default:
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/core_wine_club

# Production-like primary test DB. Never commit real credentials:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

JWT_SECRET=change_me
TELEGRAM_SENDER_MODE=mock
# TELEGRAM_BOT_TOKEN=
TELEGRAM_REAL_SEND_SCOPE=pilot
# TELEGRAM_PILOT_CHAT_ID=
# TELEGRAM_PILOT_TELEGRAM_USER_ID=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_SEND_TIMEOUT_SECONDS=10
# TELEGRAM_SEND_RATE_LIMIT_PER_SECOND=20
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
DEV_AUTH_ENABLED=true
DEV_TELEGRAM_ID=100001
DEV_TELEGRAM_USERNAME=core_dev_user
DEV_TELEGRAM_FIRST_NAME=CORE
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_PROJECT_SLUG=doch-vinodela
VITE_DEV_TELEGRAM_MOCK=true

# Cloud deployment placeholders only. Do not paste real secrets into committed files.
# Render backend:
# APP_ENV=staging
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# JWT_SECRET=change_me_to_long_random_secret
# CORS_ORIGINS=https://YOUR_FRONTEND.vercel.app,http://127.0.0.1:5173,http://localhost:5173
# DEV_AUTH_ENABLED=true
# TELEGRAM_SENDER_MODE=mock
# TELEGRAM_REAL_SEND_SCOPE=pilot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PILOT_CHAT_ID=
#
# Vercel frontend:
# VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com/api/v1
# VITE_PROJECT_SLUG=global-green-invest
# VITE_DEV_TELEGRAM_MOCK=true
